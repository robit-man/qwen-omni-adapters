diff --git a/tools/tts/reference-encode.cpp b/tools/tts/reference-encode.cpp
new file mode 100644
index 000000000..53887c6c8
--- /dev/null
+++ b/tools/tts/reference-encode.cpp
@@ -0,0 +1,99 @@
+#include "clip.h"
+#include "clip-impl.h"
+#include "ggml-backend.h"
+#include "llama.h"
+
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+
+int main(int argc, char ** argv) {
+    try {
+        if (argc == 2 && std::string(argv[1]) == "--help") {
+            std::cout << "usage: llama-tts-reference-encode MODEL INPUT_F32_24KHZ OUTPUT_I32" << std::endl;
+            return 0;
+        }
+        if (argc != 4) {
+            throw std::runtime_error("usage: llama-tts-reference-encode MODEL INPUT_F32_24KHZ OUTPUT_I32");
+        }
+        std::ifstream input(argv[2], std::ios::binary | std::ios::ate);
+        const std::streamoff bytes = input.tellg();
+        if (!input || bytes < 12000 * 4 || bytes > 720000 * 4 || bytes % 4 != 0) {
+            throw std::runtime_error("reference must be 0.5-30 seconds of mono 24kHz float32 samples");
+        }
+        clip_image_f32 audio;
+        audio.set_size({(int) (bytes / 4), 1}, false, true);
+        std::vector<float> samples((size_t) (bytes / 4));
+        input.seekg(0);
+        input.read(reinterpret_cast<char *>(samples.data()), bytes);
+        if (!input) {
+            throw std::runtime_error("incomplete reference input");
+        }
+        for (float value : samples) {
+            if (!std::isfinite(value) || std::abs(value) > 1.0f) {
+                throw std::runtime_error("invalid normalized reference sample");
+            }
+        }
+        audio.cpy_buf(samples);
+#ifdef _WIN32
+        const int precision_status = _putenv_s("NVIDIA_TF32_OVERRIDE", "0");
+#else
+        const int precision_status = setenv("NVIDIA_TF32_OVERRIDE", "0", 1);
+#endif
+        if (precision_status != 0) {
+            throw std::runtime_error("could not select full-precision reference encoding");
+        }
+        llama_backend_init();
+        clip_context_params params{};
+        params.use_gpu = true;
+        params.flash_attn_type = CLIP_FLASH_ATTN_TYPE_DISABLED;
+        params.warmup = false;
+        params.reference_encoder = true;
+        auto loaded = clip_init(argv[1], params);
+        std::unique_ptr<clip_ctx, decltype(&clip_free)> encoder(loaded.ctx_a, clip_free);
+        clip_free(loaded.ctx_v);
+        clip_free(loaded.ctx_gen_a);
+        if (!encoder || clip_n_mmproj_embd(encoder.get()) != 16) {
+            throw std::runtime_error("invalid reference encoder");
+        }
+        bool gpu_weights = false;
+        for (auto entry : clip_get_mem_usage(encoder.get())) {
+            gpu_weights |= ggml_backend_dev_type(entry.first) == GGML_BACKEND_DEVICE_TYPE_GPU && entry.second > 0;
+        }
+        if (!gpu_weights) {
+            throw std::runtime_error("reference weights are not GPU resident");
+        }
+        std::cout << "R" << std::endl;
+        std::string action;
+        if (!std::getline(std::cin, action) || action != "GO") {
+            throw std::runtime_error("reference encoding was not admitted");
+        }
+        const size_t expected = (size_t) ((audio.nx() + 1919) / 1920) * 16;
+        std::vector<float> encoded(expected);
+        clip_image_f32_batch batch;
+        batch.is_audio = true;
+        batch.entries.push_back(std::move(audio));
+        if (!clip_image_batch_encode(encoder.get(), 8, &batch, encoded) || encoded.size() != expected) {
+            throw std::runtime_error("reference encoding failed");
+        }
+        std::vector<int32_t> codes;
+        for (float value : encoded) {
+            if (!std::isfinite(value) || value < 0 || value >= 2048 || value != std::floor(value)) {
+                throw std::runtime_error("invalid reference code");
+            }
+            codes.push_back((int32_t) value);
+        }
+        std::ofstream output(argv[3], std::ios::binary);
+        output.write(reinterpret_cast<const char *>(codes.data()), codes.size() * sizeof(int32_t));
+        if (!output) {
+            throw std::runtime_error("reference output failed");
+        }
+        return 0;
+    } catch (const std::exception & error) {
+        std::cerr << error.what() << std::endl;
+        return 1;
+    }
+}
