diff --git a/tools/mtmd/models/qwen3tts-refenc.cpp b/tools/mtmd/models/qwen3tts-refenc.cpp
new file mode 100644
index 000000000..5dcd61437
--- /dev/null
+++ b/tools/mtmd/models/qwen3tts-refenc.cpp
@@ -0,0 +1,49 @@
+#include "models.h"
+
+ggml_cgraph * clip_graph_qwen3tts_refenc::build() {
+    ggml_tensor * raw = build_inp_raw(1);
+    ggml_tensor * cur = ggml_reshape_2d(ctx0, raw, raw->ne[0], raw->ne[1]);
+    clip_graph_pockettts_seanet seanet(*this);
+    cur = seanet.encode(cur);
+    cb(cur, "reference_seanet", -1);
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+
+    ggml_tensor * positions = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, cur->ne[1]);
+    ggml_set_name(positions, "inp_pos");
+    ggml_set_input(positions);
+    ggml_tensor * mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, cur->ne[1], cur->ne[1]);
+    ggml_set_name(mask, "kq_mask");
+    ggml_set_input(mask);
+    for (int il = 0; il < n_layer; ++il) {
+        cur = tfm_layer_forward(cur, model.layers[il], positions, mask, il);
+    }
+    cb(cur, "reference_transformer", -1);
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = seanet.conv1d(cur, model.downsample_w, nullptr, 2, 1, true);
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cb(cur, "reference_downsample", -1);
+
+    ggml_tensor * codes = nullptr;
+    for (int group = 0; group < 2; ++group) {
+        ggml_tensor * projection = group == 0 ? model.ref_semantic_in : model.ref_acoustic_in;
+        ggml_tensor * books = group == 0 ? model.ref_semantic_book : model.ref_acoustic_books;
+        ggml_tensor * residual = build_mm(projection, cur);
+        const int count = group == 0 ? 1 : 15;
+        for (int q = 0; q < count; ++q) {
+            ggml_tensor * book = ggml_view_2d(ctx0, books, books->ne[0], books->ne[1], books->nb[1], q * books->nb[2]);
+            book = ggml_cont(ctx0, book);
+            ggml_tensor * norm = ggml_sum_rows(ctx0, ggml_sqr(ctx0, book));
+            norm = ggml_cont(ctx0, ggml_transpose(ctx0, norm));
+            ggml_tensor * score = ggml_sub(ctx0, ggml_scale(ctx0, build_mm(book, residual), 2.0f), norm);
+            ggml_tensor * index = ggml_argmax(ctx0, score);
+            cb(index, "reference_code", group == 0 ? 0 : q + 1);
+            ggml_tensor * row = ggml_reshape_2d(ctx0, ggml_cast(ctx0, index, GGML_TYPE_F32), 1, index->ne[0]);
+            codes = codes ? ggml_concat(ctx0, codes, row, 0) : row;
+            if (q + 1 < count) {
+                residual = ggml_sub(ctx0, residual, ggml_get_rows(ctx0, book, index));
+            }
+        }
+    }
+    ggml_build_forward_expand(gf, codes);
+    return gf;
+}
