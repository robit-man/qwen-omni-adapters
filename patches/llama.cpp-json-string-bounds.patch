+static std::pair<bool, bool> accepts_json(const std::string & grammar, const std::string & text);
+
+static void test_json_string_bounds() {
+    for (int maximum : {1999, 2000, 2048, 4096}) {
+        for (int minimum : {0, 1, maximum}) {
+            auto schema = common_json{{"type", "string"}, {"minLength", minimum}, {"maxLength", maximum}};
+            for (bool pattern : {false, true}) {
+                if (pattern) {
+                    schema["pattern"] = R"(^[^\u0000]+$)";
+                }
+                auto grammar = json_schema_to_grammar(schema, true);
+                for (int length : {0, 1, maximum - 1, maximum, maximum + 1}) {
+                    bool expected = length >= minimum && length <= maximum;
+                    auto text = common_json(std::string(length, 'a')).dump();
+                    assert(accepts_json(grammar, text).second == expected);
+                }
+            }
+        }
+    }
+    for (const auto & unit : {std::string("\\\""), std::string("\\\\"), std::string("\\u00e9"), std::string("😀")}) {
+        auto grammar = json_schema_to_grammar(common_json{{"type", "string"}, {"minLength", 1},
+            {"maxLength", 2048}, {"pattern", R"(^[^\u0000]+$)"}}, true);
+        for (int length : {1, 2047, 2048, 2049}) {
+            std::string text = "\"";
+            for (int i = 0; i < length; ++i) {
+                text += unit;
+            }
+            text += "\"";
+            assert(accepts_json(grammar, text).second == (length <= 2048));
+        }
+    }
+    // Existing JSON char units count surrogate escapes separately. This may
+    // reject valid paired-escape encodings conservatively; never over-admit an
+    // upper bound or claim all equivalent Unicode encodings are accepted.
+    auto conservative = json_schema_to_grammar(common_json{{"type", "string"}, {"minLength", 1},
+        {"maxLength", 2048}, {"pattern", R"(^[^\u0000]+$)"}}, true);
+    std::string paired = "\"";
+    for (int i = 0; i < 2048; ++i) {
+        paired += R"(\ud83d\ude00)";
+    }
+    paired += "\"";
+    assert(!accepts_json(conservative, paired).second);
+    // For decoded minima > 1 the same existing unit behavior can over-admit
+    // too-short paired-escape strings. Full host validation remains required.
+    auto lower = json_schema_to_grammar(common_json{{"type", "string"},
+        {"minLength", 2}, {"maxLength", 2}}, true);
+    assert(accepts_json(lower, R"("\ud83d\ude00")").second);
+
+    fprintf(stderr, "JSON string bound native controls passed\n");
+}
