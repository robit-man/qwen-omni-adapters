+    std::string _build_string_rule(const json & schema, const std::string & name) {
+        if (!schema.contains("minLength") && !schema.contains("maxLength")) {
+            return _add_rule(name, _add_primitive("string", PRIMITIVE_RULES.at("string")));
+        }
+        int min_len = schema.contains("minLength") ? schema["minLength"].get<int>() : 0;
+        bool has_max = schema.contains("maxLength");
+        int max_len = has_max ? schema["maxLength"].get<int>() : std::numeric_limits<int>::max();
+        if (min_len < 0 || max_len < min_len) {
+            throw std::invalid_argument("Invalid string length bounds");
+        }
+        auto character = _add_primitive("char", PRIMITIVE_RULES.at("char"));
+        std::string repeated;
+        if (min_len < 2000 && (!has_max || max_len < 2000)) {
+            repeated = build_repetition(character, min_len, max_len);
+        } else {
+            // The pinned parser rejects an exact 2,000 repeat and silently
+            // treats larger maxima as unbounded. Compose the same finite
+            // language from named binary blocks, without large repetitions.
+            std::map<int, std::string> blocks{{1, character}};
+            std::function<std::string(int)> block = [&](int count) {
+                auto found = blocks.find(count);
+                if (found != blocks.end()) {
+                    return found->second;
+                }
+                auto half = block(count / 2);
+                return blocks[count] = _add_rule(name + "-count-" + std::to_string(count), half + " " + half);
+            };
+            std::function<std::string(int)> upto = [&](int count) -> std::string {
+                if (count == 0) {
+                    return "";
+                }
+                int power = 1;
+                while (power <= count / 2) {
+                    power *= 2;
+                }
+                auto lower = upto(power - 1);
+                if (count - power == power - 1) {
+                    return block(power) + "? " + lower;
+                }
+                return _add_rule(name + "-upto-" + std::to_string(count),
+                    lower + " | " + block(power) + " " + upto(count - power));
+            };
+            for (int remaining = min_len; remaining > 0;) {
+                int power = 1;
+                while (power <= remaining / 2) {
+                    power *= 2;
+                }
+                repeated += block(power) + " ";
+                remaining -= power;
+            }
+            repeated += has_max ? upto(max_len - min_len) : character + "*";
+        }
+        return _add_rule(name, "\"\\\"\" " + repeated + " \"\\\"\"");
+    }
