+int32_t mtmd_gen_audio_code_embeddings(mtmd_context * ctx, const int32_t * codes,
+        size_t n_codes, float * output, size_t output_capacity) {
+    if (!ctx || !codes || !output || n_codes == 0 || n_codes % 16 != 0 || n_codes > 375 * 16 ||
+            mtmd_gen_audio_get_info(ctx).type != MTMD_GEN_AUDIO_TYPE_QWEN3TTS) {
+        return 1;
