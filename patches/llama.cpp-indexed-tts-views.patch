diff --git a/ggml/include/gguf.h b/ggml/include/gguf.h
index b3a1e1230..8021ea192 100644
--- a/ggml/include/gguf.h
+++ b/ggml/include/gguf.h
@@ -89,6 +89,14 @@ extern "C" {
 
     GGML_API void gguf_free(struct gguf_context * ctx);
 
+    // Select one namespaced, read-only tensor view after a no_alloc load.
+    // Replaces/frees *tensor_context only on success. File data offset, tensor
+    // offsets, shapes and quantization stay bound to the original source file.
+    // The selected context is a loader view and must not be serialized.
+    GGML_API bool gguf_select_tensor_view(struct gguf_context * ctx,
+            const char * tensor_prefix, const char * metadata_prefix,
+            struct ggml_context ** tensor_context);
+
     GGML_API const char * gguf_type_name(enum gguf_type type);
 
     GGML_API uint32_t gguf_get_version    (const struct gguf_context * ctx);
diff --git a/ggml/src/gguf.cpp b/ggml/src/gguf.cpp
index 6c7b58178..6c5c8dce8 100644
--- a/ggml/src/gguf.cpp
+++ b/ggml/src/gguf.cpp
@@ -227,6 +227,74 @@ struct gguf_context {
     void * data = nullptr;
 };
 
+bool gguf_select_tensor_view(struct gguf_context * ctx,
+        const char * tensor_prefix, const char * metadata_prefix,
+        struct ggml_context ** tensor_context) {
+    if (!ctx || ctx->data || !tensor_context || !*tensor_context ||
+            !tensor_prefix || !*tensor_prefix || !metadata_prefix || !*metadata_prefix) {
+        GGML_LOG_ERROR("%s: a no_alloc context and nonempty prefixes are required\n", __func__);
+        return false;
+    }
+    const std::string tp(tensor_prefix), mp(metadata_prefix);
+    std::vector<gguf_kv> metadata;
+    std::vector<gguf_tensor_info> tensors;
+    bool architecture = false;
+    for (const auto & source : ctx->kv) {
+        if (source.key.compare(0, mp.size(), mp) != 0) {
+            continue;
+        }
+        gguf_kv item = source;
+        item.key.erase(0, mp.size());
+        if (item.key.empty()) {
+            return false;
+        }
+        if (item.key == "general.architecture") {
+            architecture = !item.is_array && item.type == GGUF_TYPE_STRING &&
+                           !item.get_val<std::string>().empty();
+            if (!architecture) {
+                return false;
+            }
+        }
+        metadata.push_back(std::move(item));
+    }
+    for (const auto & source : ctx->info) {
+        const std::string name(source.t.name);
+        if (name.compare(0, tp.size(), tp) != 0) {
+            continue;
+        }
+        const std::string selected_name = name.substr(tp.size());
+        if (selected_name.empty()) {
+            return false;
+        }
+        gguf_tensor_info item = source;
+        ggml_set_name(&item.t, selected_name.c_str());
+        tensors.push_back(item); // preserve original source offset, never compact it
+    }
+    if (!architecture || tensors.empty() || tensors.size() > SIZE_MAX / ggml_tensor_overhead()) {
+        GGML_LOG_ERROR("%s: missing component architecture or tensors\n", __func__);
+        return false;
+    }
+    struct ggml_context * selected = ggml_init({tensors.size() * ggml_tensor_overhead(), nullptr, true});
+    if (!selected) {
+        return false;
+    }
+    for (const auto & item : tensors) {
+        struct ggml_tensor * tensor = ggml_new_tensor(selected, item.t.type, GGML_MAX_DIMS, item.t.ne);
+        if (!tensor) {
+            ggml_free(selected);
+            return false;
+        }
+        ggml_set_name(tensor, item.t.name);
+    }
+    // Commit only after all metadata and tensor descriptors are valid. The
+    // container's physical alignment, data offset and size remain unchanged.
+    ctx->kv = std::move(metadata);
+    ctx->info = std::move(tensors);
+    ggml_free(*tensor_context);
+    *tensor_context = selected;
+    return true;
+}
