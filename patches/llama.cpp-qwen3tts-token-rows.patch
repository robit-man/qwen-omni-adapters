 // caller must allocate enough memory for out before calling
 LLAMA_API uint32_t llama_model_get_tok_embd(const struct llama_model * model, float * out);
+
+// Read one row from the existing checkpoint without expanding the whole table.
+// With out == nullptr, query the row width; return 0 for invalid ids/capacity.
+LLAMA_API uint32_t llama_model_get_tok_embd_row(const struct llama_model * model,
+    llama_token token, float * out, size_t capacity);
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index e679b24e8..d08f462a2 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -3223,3 +3223,37 @@ uint32_t llama_model_get_tok_embd(const struct llama_model * model, float * out)
 
     return (uint32_t) nelements;
 }
+
+uint32_t llama_model_get_tok_embd_row(const struct llama_model * model,
+        llama_token token, float * out, size_t capacity) {
+    if (!model || !model->tok_embd || token < 0 || token >= model->tok_embd->ne[1]) {
+        return 0;
+    }
+    const ggml_tensor * tensor = model->tok_embd;
+    const size_t width = (size_t) tensor->ne[0];
+    if (width > UINT32_MAX || (out && capacity < width)) {
+        return 0;
+    }
+    if (!out) {
+        return (uint32_t) width;
+    }
+    const size_t offset = (size_t) token * tensor->nb[1];
+    if (tensor->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_get(tensor, out, offset, width * sizeof(float));
+        return (uint32_t) width;
+    }
+    std::vector<uint8_t> bytes(ggml_row_size(tensor->type, width));
+    ggml_backend_tensor_get(tensor, bytes.data(), offset, bytes.size());
+    if (tensor->type == GGML_TYPE_F16) {
+        ggml_fp16_to_fp32_row((const ggml_fp16_t *) bytes.data(), out, width);
+    } else if (tensor->type == GGML_TYPE_BF16) {
+        ggml_bf16_to_fp32_row((const ggml_bf16_t *) bytes.data(), out, width);
+    } else {
+        const auto * traits = ggml_get_type_traits(tensor->type);
+        if (!ggml_is_quantized(tensor->type) || !traits->to_float) {
+            return 0;
+        }
+        traits->to_float(bytes.data(), out, width);
+    }
+    return (uint32_t) width;
+}
