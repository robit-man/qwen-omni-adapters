+static std::pair<bool, bool> accepts_json(const std::string & grammar, const std::string & text) {
+    auto * state = llama_grammar_init_impl(nullptr, grammar.c_str(), "root", false, nullptr, 0, nullptr, 0);
+    assert(state != nullptr);
+    std::wstring_convert<std::codecvt_utf8<char32_t>, char32_t> utf8;
+    for (auto c : utf8.from_bytes(text)) {
+        llama_grammar_accept(state, c);
+        if (state->stacks.empty()) {
+            llama_grammar_free_impl(state);
+            return {false, false};
+        }
+    }
+    bool complete = false;
+    for (const auto & stack : state->stacks) {
+        complete |= stack.empty();
+    }
+    llama_grammar_free_impl(state);
+    return {true, complete};
+}
+
+static void test_json_pattern_safety() {
+    const auto plain = json_schema_to_grammar(common_json::parse(R"({"type":"string","pattern":"unanchored"})"), true);
+    // These decoded-character patterns cannot be emitted directly between JSON
+    // quotes. Existing warned string fallback preserves JSON syntax; the caller
+    // still validates the decoded pattern (including nonempty/non-NUL).
+    const std::vector<std::string> unsafe = {
+        R"(^[^\u0000]+$)", R"(^[\u0000-\uFFFF]+$)", R"(^[\U00000022]+$)",
+        R"(^[ -~]+$)", R"(^["a]+$)", R"(^[\\]+$)", R"(^[\t]+$)", R"(^[^a]+$)",
+        R"(^.*$)", R"(^"$)", R"(^\\$)", R"(^\n$)", R"(^\u0022$)"
+    };
+    for (const auto & pattern : unsafe) {
+        const auto grammar = json_schema_to_grammar(common_json{{"type", "string"}, {"pattern", pattern}}, true);
+        assert(grammar == plain);
+        for (const auto & body : {R"("plain")", R"("quoted\"text")", R"("slash\\text")",
+                                 R"("line\n\tend")", R"("\u0000")", R"("")", R"("caf\u00e9")"}) {
+            assert(accepts_json(grammar, body) == std::make_pair(true, true));
+        }
+        for (const auto & body : {R"("x"}})", R"("a"b")", R"("a\q")", "\"raw\nline\"", "\"raw\tcontrol\""}) {
+            assert(!accepts_json(grammar, body).first);
+        }
+    }
+    for (const auto & pattern : {R"(^[A-Za-z][A-Za-z0-9_]*$)", R"(^[^"\\\x00-\x1F]+$)", R"(^[\u0100-\u0200]+$)"}) {
+        const auto grammar = json_schema_to_grammar(common_json{{"type", "string"}, {"pattern", pattern}}, true);
+        assert(grammar != plain);
+        assert(!accepts_json(grammar, R"("bad\q")").first);
+    }
+    // Public C++ callers can construct strings that a JSON parser would reject.
+    // Truncated and malformed UTF-8 atoms must never read beyond their bounds.
+    for (const auto & atom : {std::string("\xC2", 1), std::string("\xE0\x80", 2),
+                             std::string("\xF0\x80\x80", 3), std::string("\xC0\x80", 2),
+                             std::string("\xED\xA0\x80", 3), std::string("\xF5\x80\x80\x80", 4)}) {
+        for (const auto & pattern : {"^" + atom + "$", "^[" + atom + "]$", "^[a-" + atom + "]$"}) {
+            assert(json_schema_to_grammar(common_json{{"type", "string"}, {"pattern", pattern}}, true) == plain);
+        }
+    }
+    for (const auto & pattern : {R"(^[\u002]$)", R"(^[a-\U0000002]$)", R"(^\u002$)"}) {
+        assert(json_schema_to_grammar(common_json{{"type", "string"}, {"pattern", pattern}}, true) == plain);
+    }
+    fprintf(stderr, "JSON pattern structural-safety controls passed\n");
+}
