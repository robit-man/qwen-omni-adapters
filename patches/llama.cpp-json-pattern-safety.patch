+// Pattern atoms describe decoded characters, whereas GBNF consumes JSON text/codepoints.
+// Until escaping can be composed with arbitrary regexes, only emit atoms that
+// cannot consume a JSON delimiter, escape introducer or unescaped control.
+static bool pattern_codepoint(const std::string & text, size_t & pos, uint32_t & c) {
+    if (pos >= text.size()) {
+        return false;
+    }
+    c = static_cast<unsigned char>(text[pos++]);
+    if (c == '\\') {
+        if (gbnf_escape_length(text, pos - 1) == 0) {
+            return false;
+        }
+        char escape = text[pos++];
+        switch (escape) {
+            case 't': c = '\t'; break;
+            case 'r': c = '\r'; break;
+            case 'n': c = '\n'; break;
+            case 'x': case 'u': case 'U': {
+                size_t digits = escape == 'x' ? 2 : escape == 'u' ? 4 : 8;
+                c = std::stoul(text.substr(pos, digits), nullptr, 16);
+                pos += digits;
+                break;
+            }
+            default: c = static_cast<unsigned char>(escape); break;
+        }
+    } else if (c >= 0x80) {
+        int continuation = c < 0xE0 ? 1 : c < 0xF0 ? 2 : 3;
+        if (c < 0xC2 || c > 0xF4 || text.size() - pos < static_cast<size_t>(continuation)) {
+            return false;
+        }
+        uint32_t minimum = continuation == 1 ? 0x80 : continuation == 2 ? 0x800 : 0x10000;
+        c &= (1u << (6 - continuation)) - 1;
+        while (continuation--) {
+            auto next = static_cast<unsigned char>(text[pos++]);
+            if ((next & 0xC0) != 0x80) {
+                return false;
+            }
+            c = (c << 6) | (next & 0x3F);
+        }
+        if (c < minimum) {
+            return false;
+        }
+    }
+    return c <= 0x10FFFF && !(c >= 0xD800 && c <= 0xDFFF);
+}
+
+static bool json_safe_pattern_class(const std::string & text) {
+    bool negated = text[1] == '^';
+    bool matched[0x5D] = {};
+    size_t pos = negated ? 2 : 1;
+    while (pos < text.size() - 1) {
+        uint32_t first;
+        if (!pattern_codepoint(text, pos, first)) {
+            return false;
+        }
+        uint32_t last = first;
+        if (pos < text.size() - 2 && text[pos] == '-') {
+            ++pos;
+            if (!pattern_codepoint(text, pos, last)) {
+                return false;
+            }
+        }
+        for (uint32_t c = 0; c < 0x5D; ++c) {
+            if (first <= c && c <= last) {
+                matched[c] = true;
+            }
+        }
+    }
+    for (uint32_t c = 0; c < 0x5D; ++c) {
+        if ((c < 0x20 || c == '"' || c == '\\') && matched[c] != negated) {
+            return false;
+        }
+    }
+    return true;
+}
