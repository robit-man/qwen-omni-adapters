[Unit]
Description=Omni call harness (always-listening voice with a top-bar indicator)
Documentation=file://@REPO_ROOT@/README.md
# The adapter is a system unit and cannot be named as a dependency from this
# user manager. The harness polls the loopback portal and follows token changes.
# The indicator needs the desktop session's bus and display, which GNOME
# imports into the user manager only once the session is up. This graphical
# target plus the mandatory preflight prevent a silent headless start.
After=sound.target pipewire-pulse.service pulseaudio.service graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@REPO_ROOT@
Environment=OMNI_REPO_ROOT=@REPO_ROOT@
Environment=OMNI_PORTAL_URL=http://127.0.0.1:8920
Environment=OMNI_DECISION_PLANE_ENABLED=1
Environment=OMNI_DECISION_PLANE_URL=http://127.0.0.1:8930
Environment=OMNI_REQUIRE_INDICATOR=1
EnvironmentFile=-@REPO_ROOT@/.env
ExecStartPre=@HARNESS_EXEC_START@ --check
ExecStart=@HARNESS_EXEC_START@
Restart=always
RestartSec=5
TimeoutStopSec=20
# A conversation is not worth taking the machine down for. The adapter holds
# the weights; this process only moves audio.
MemoryMax=4G

[Install]
WantedBy=graphical-session.target
