[Unit]
Description=Qwen Omni Adapters runtime and dashboard
After=network-online.target ollama.service docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment=OMNI_REPO_ROOT=@REPO_ROOT@
EnvironmentFile=-@REPO_ROOT@/.env
ExecStart=@EXEC_START@
Restart=on-failure
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# X11 uses a Unix socket under /tmp. Re-expose only that socket directory in
# the private namespace; Wayland and the user bus remain under /run/user/UID.
BindReadOnlyPaths=-/tmp/.X11-unix
ProtectSystem=full
ReadWritePaths=-@REPO_ROOT@/runtime-data

[Install]
WantedBy=multi-user.target
