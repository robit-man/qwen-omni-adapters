# Published logical Ollama bundle and the stock-runnable language tag sharing its base blobs.
OMNI_MODEL=robit/qwen3.8-27b-e03-obliterated-omni:q4km
OMNI_LANGUAGE_MODEL=robit/qwen3.8-27b-obliterated-e03:27b

# Runtime and sizing. A 65k context avoids the old 8k video overflow.
OMNI_COMPREHENSION_CONTEXT_TOKENS=65536
OMNI_COMPREHENSION_VRAM_MIB=45000
OMNI_TTS_STREAM_FRAMES=4

# Optional fixed broker-selected GPU. Leave unset for broker-approved discovery.
# OMNI_COMPREHENSION_GPU_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional stable access token. If unset, every deployment generates one.
# OMNI_PORTAL_TOKEN=replace-with-at-least-24-random-characters

# Preserve materialized GGUF views across a normal stop. Default 0 cleans them.
OMNI_KEEP_CACHE=0
